rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isOwner() {
      return signedIn() && request.auth.token.email == 'jonic70134@gmail.com';
    }

    function memberExists() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function member() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function isActiveMember() {
      return memberExists()
        && member().uid == request.auth.uid
        && member().email == request.auth.token.email
        && member().status == 'active'
        && member().role in ['admin', 'user'];
    }

    function hasAccess() {
      return isOwner() || isActiveMember();
    }

    function isAdmin() {
      return isOwner() || (isActiveMember() && member().role == 'admin');
    }

    function boundedList(maximum) {
      return request.query.limit != null && request.query.limit <= maximum;
    }

    function allowedInviteRole(role) {
      return role in ['admin', 'user'];
    }

    function validRecordAudit(recordId, action) {
      let auditId = request.resource.data.lastAuditId;
      let entry = getAfter(/databases/$(database)/documents/activityLogs/$(auditId)).data;
      return !exists(/databases/$(database)/documents/activityLogs/$(auditId))
        && entry.actorId == request.auth.uid
        && entry.action == action
        && entry.recordId == recordId
        && entry.timestamp == request.time;
    }

    function validActivityShape() {
      let entry = request.resource.data;
      return signedIn()
        && entry.keys().hasOnly(['actorId', 'actorEmail', 'actorName', 'action', 'recordId', 'recordTitle', 'timestamp'])
        && entry.actorId == request.auth.uid
        && entry.actorEmail == request.auth.token.email
        && entry.actorName is string
        && entry.actorName.size() <= 160
        && entry.recordTitle is string
        && entry.recordTitle.size() <= 500
        && entry.recordId is string
        && entry.recordId.size() <= 320
        && entry.timestamp == request.time;
    }

    match /locations/{locationId} {
      allow get: if hasAccess();
      allow list: if hasAccess() && boundedList(100);
      allow create: if hasAccess()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 300;
      allow update: if hasAccess()
        && (isAdmin() || resource.data.createdBy == request.auth.uid)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /workRecords/{recordId} {
      allow get: if hasAccess();
      allow list: if hasAccess() && boundedList(100);
      allow create: if hasAccess()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && (
          validRecordAudit(recordId, 'create')
          || (isAdmin() && request.resource.data.sourceImported == true && validRecordAudit(recordId, 'update'))
        );
      allow update: if hasAccess()
        && (isAdmin() || resource.data.authorId == request.auth.uid)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && validRecordAudit(recordId, 'update');
      allow delete: if isAdmin()
        && getAfter(/databases/$(database)/documents/recordDeletions/$(recordId)).data.timestamp == request.time
        && getAfter(/databases/$(database)/documents/recordDeletions/$(recordId)).data.actorId == request.auth.uid;
    }

    match /activityLogs/{entryId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && boundedList(100);
      allow create: if validActivityShape() && (
        (request.resource.data.action in ['login', 'logout']
          && hasAccess()
          && request.resource.data.recordId == '')
        || (request.resource.data.action in ['plan_image_save', 'plan_pdf_save']
          && isAdmin()
          && request.resource.data.recordId == '')
        || (request.resource.data.action == 'invite_accept'
          && request.resource.data.recordId == request.auth.uid
          && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.email == request.auth.token.email
          && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.acceptedBy == request.auth.uid)
        || (request.resource.data.action in ['invite_create', 'invite_revoke']
          && isOwner())
        || (request.resource.data.action in ['member_role', 'member_enable', 'member_disable']
          && isAdmin())
        || (request.resource.data.action == 'edit'
          && hasAccess()
          && (isAdmin() || get(/databases/$(database)/documents/workRecords/$(request.resource.data.recordId)).data.authorId == request.auth.uid))
        || (request.resource.data.action in ['create', 'update']
          && hasAccess()
          && getAfter(/databases/$(database)/documents/workRecords/$(request.resource.data.recordId)).data.lastAuditId == entryId
          && getAfter(/databases/$(database)/documents/workRecords/$(request.resource.data.recordId)).data.updatedAt == request.time)
        || (request.resource.data.action == 'delete'
          && isAdmin()
          && getAfter(/databases/$(database)/documents/recordDeletions/$(request.resource.data.recordId)).data.auditId == entryId
          && (exists(/databases/$(database)/documents/workRecords/$(request.resource.data.recordId))
            || getAfter(/databases/$(database)/documents/importedRecordStates/$(request.resource.data.recordId)).data.deleted == true)
          && !existsAfter(/databases/$(database)/documents/workRecords/$(request.resource.data.recordId)))
      );
      allow update, delete: if false;
    }

    match /accessInvites/{inviteEmail} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email == inviteEmail);
      allow list: if isAdmin() && boundedList(100);

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'role', 'status', 'invitedBy', 'invitedByEmail', 'invitedAt', 'updatedAt'])
        && request.resource.data.email == inviteEmail
        && request.resource.data.status == 'pending'
        && allowedInviteRole(request.resource.data.role)
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.invitedByEmail == request.auth.token.email
        && request.resource.data.invitedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (
        signedIn()
        && request.auth.token.email == inviteEmail
        && resource.data.email == inviteEmail
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt', 'updatedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.email == inviteEmail
      ) || (
        isOwner()
        && resource.data.email == inviteEmail
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'revoked'
        && request.resource.data.updatedAt == request.time
      ) || (
        isOwner()
        && request.resource.data.keys().hasOnly(['email', 'role', 'status', 'invitedBy', 'invitedByEmail', 'invitedAt', 'updatedAt'])
        && request.resource.data.email == inviteEmail
        && request.resource.data.status == 'pending'
        && allowedInviteRole(request.resource.data.role)
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.invitedByEmail == request.auth.token.email
        && request.resource.data.invitedAt == request.time
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if false;
    }

    match /members/{memberId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == memberId);
      allow list: if isAdmin() && boundedList(100);

      allow create: if signedIn()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'invitedBy', 'invitedAt', 'acceptedAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 160
        && request.resource.data.status == 'active'
        && request.resource.data.role == get(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.role
        && get(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.acceptedBy == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.invitedBy == resource.data.invitedBy
        && request.resource.data.invitedAt == resource.data.invitedAt
        && request.resource.data.acceptedAt == resource.data.acceptedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['active', 'disabled']
        && request.resource.data.role in ['admin', 'user']
        && (
          isOwner()
          || (isActiveMember()
            && member().role == 'admin'
            && memberId != request.auth.uid)
        );
      allow delete: if isAdmin() && memberId != request.auth.uid;
    }

    match /recordDeletions/{recordId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && boundedList(100);
      allow create: if isAdmin()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recordId == recordId
        && request.resource.data.timestamp == request.time
        && getAfter(/databases/$(database)/documents/activityLogs/$(request.resource.data.auditId)).data.action == 'delete'
        && getAfter(/databases/$(database)/documents/activityLogs/$(request.resource.data.auditId)).data.recordId == recordId
        && (exists(/databases/$(database)/documents/workRecords/$(recordId))
          || getAfter(/databases/$(database)/documents/importedRecordStates/$(recordId)).data.deleted == true)
        && !existsAfter(/databases/$(database)/documents/workRecords/$(recordId));
      allow update, delete: if false;
    }

    match /importedRecordStates/{recordId} {
      allow get: if hasAccess();
      allow list: if hasAccess() && boundedList(100);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['deleted', 'updatedAt', 'auditId'])
        && request.resource.data.deleted == true
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/activityLogs/$(request.resource.data.auditId)).data.action == 'delete'
        && getAfter(/databases/$(database)/documents/activityLogs/$(request.resource.data.auditId)).data.recordId == recordId;
      allow update, delete: if false;
    }

    match /drafts/{draftId} {
      function validDraft() {
        let draft = request.resource.data;
        return draft.keys().hasOnly([
            'kind', 'title', 'data', 'createdBy', 'createdByName',
            'updatedBy', 'updatedByName', 'updatedAt', 'saveMode',
            'sizeBytes', 'assetCount'
          ])
          && draft.kind in ['work_record', 'pruning_plan']
          && draft.title is string
          && draft.title.size() <= 500
          && draft.data is map
          && draft.createdBy is string
          && draft.createdByName is string
          && draft.updatedBy == request.auth.uid
          && draft.updatedByName is string
          && draft.updatedAt == request.time
          && draft.saveMode in ['manual', 'auto']
          && draft.sizeBytes is int
          && draft.sizeBytes >= 0
          && draft.sizeBytes <= 104857600
          && draft.assetCount is int
          && draft.assetCount >= 0;
      }

      allow get: if isAdmin();
      allow list: if isAdmin() && boundedList(100);
      allow create: if isAdmin()
        && validDraft()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && validDraft()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();

      match /assets/{assetId} {
        allow get: if isAdmin();
        allow list: if isAdmin() && boundedList(100);
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['dataUrl', 'sizeBytes', 'updatedAt'])
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 700000
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes >= 0
          && request.resource.data.sizeBytes <= 700000
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin();
      }
    }

    match /users/{userId} {
      allow get: if isAdmin() || (hasAccess() && request.auth.uid == userId);
      allow list: if isAdmin() && boundedList(100);
      allow create: if hasAccess() && request.auth.uid == userId && request.resource.data.role == 'user';
      allow update: if isAdmin() || (hasAccess() && request.auth.uid == userId && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /invitations/{invitationId} {
      allow get, create, update, delete: if isOwner();
      allow list: if isOwner() && boundedList(100);
    }
  }
}
