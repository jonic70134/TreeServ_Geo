rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.token.email == 'jonic70134@gmail.com';
    }

    // Work content is collaborative, but administrative and invitation
    // authority is reserved for the single owner email above.
    function canWrite() {
      return signedIn();
    }

    match /locations/{locationId} {
      allow read: if true;
      allow create: if canWrite() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner() || (canWrite() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isOwner();
    }

    match /workRecords/{recordId} {
      allow read: if true;
      allow create: if canWrite() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner() || (canWrite() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId);
      allow delete: if isOwner();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == 'user';
      allow update: if isOwner() || (
        signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );
      allow delete: if isOwner();
    }

    match /invitations/{invitationId} {
      allow read, create, update, delete: if isOwner();
    }
  }
}
